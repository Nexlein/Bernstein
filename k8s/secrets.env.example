# Template for k8s/secrets.env (gitignored, never commit it).
#   cp k8s/secrets.env.example k8s/secrets.env
# Fill in the values, then deploy with: REGISTRY=<name>.azurecr.io scripts/deploy.sh
# Format: KEY=value, one per line, no quotes, no spaces around "=".

# Required. Password of the PostgreSQL "postgres" superuser (the database itself, backups).
POSTGRES_PASSWORD=

# Required. Passwords of the app users: Result reads the votes, the worker writes them.
# Any value, e.g. from: openssl rand -hex 24
RESULT_DB_PASSWORD=
WORKER_DB_PASSWORD=

# Optional. Leave empty to run Redis without authentication.
REDIS_PASSWORD=
