# Local Docker Compose only (docker compose up). The Kubernetes deployment does not use it:
# the cluster reads k8s/secrets.env (template: k8s/secrets.env.example).
#   cp .env.example .env    (.env is gitignored)
# Compose reads only this variable from .env; without it, the password is "postgres".
POSTGRES_PASSWORD=change_this_to_a_secure_password
